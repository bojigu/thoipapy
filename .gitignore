# Anything starting with .env, not just `.env` itself. The copies that leak are hand-made names
# such as .env.bak-20260908 or .env-old, which match neither `.env` nor `*.bak`. .env.example is
# the documented template, carries no secrets, and is committed.
.env*
!.env.example

# Added by ggshield
.cache_ggshield

# Names the conda environment to activate. The canonical name is in environment.yml, so a
# tracked copy here can only ever disagree with somebody's machine. Copy .conda-env.example
# and edit it if your environment is named something else.
.conda-env
.envrc
